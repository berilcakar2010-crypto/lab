{
  "name": "lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lab \u2014 a personal academic operating system",
  "scripts": {
    "dev": "node scripts/copy-pyodide.mjs && node scripts/fetch-pyodide-packages.mjs && vite",
    "build": "node scripts/copy-pyodide.mjs && node scripts/fetch-pyodide-packages.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "python:packages": "node scripts/copy-pyodide.mjs && node scripts/fetch-pyodide-packages.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "pyodide": "^0.27.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
